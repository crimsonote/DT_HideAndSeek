<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>HideAndSeek</AssemblyName>
    <Description>Deadly Trick - Hide and Seek mode (host-side only)</Description>
    <Version>0.3.6</Version>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CS0649</NoWarn>

    <!-- 游戏程序集（仓库内 libs，与 DT_Tools 共用） -->
    <GameManaged Condition="'$(GameManaged)' == ''">$(MSBuildThisFileDirectory)..\libs</GameManaged>

    <!-- 游戏安装目录，仅用于取 BepInEx\core 下的 BepInEx.dll / 0Harmony.dll。
         换机器或换盘符时用 -p:GameDir=... 覆盖即可。 -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Deadly Trick</GameDir>
    <BepInExCore>$(GameDir)\BepInEx\core</BepInExCore>
  </PropertyGroup>

  <!-- 刻意不使用 NuGet：本机沙箱内 HTTPS 直连 nuget.org 不可用（Schannel 受限令牌），
       而游戏已装 BepInEx 5.4.23.5，直接引用其 core 程序集即可。 -->
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCore)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCore)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Google.Protobuf">
      <HintPath>$(GameManaged)\Google.Protobuf.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
