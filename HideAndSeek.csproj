<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>HideAndSeek</AssemblyName>
    <Description>Deadly Trick - Hide and Seek mode (host-side only)</Description>
    <Version>1.4.0</Version>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CS0649</NoWarn>

    <!-- 游戏安装目录：换机器或换盘符时用 -p:GameDir=... 覆盖即可。 -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Deadly Trick</GameDir>
    <BepInExCore>$(GameDir)\BepInEx\core</BepInExCore>

    <!-- 游戏程序集。默认直接取游戏安装目录里的 Managed —— 那是**唯一**权威来源
         （与插件运行期实际加载的是同一份文件），也让本仓库不依赖 DT_Tools 的 libs/：
         本插件是独立仓库，单独 clone 下来只需填对 GameDir 就能构建。
         需要用仓库内快照（固定版本、可复现）时覆盖：-p:GameManaged=..\libs -->
    <GameManaged Condition="'$(GameManaged)' == ''">$(GameDir)\DeadlyTrick_Data\Managed</GameManaged>
  </PropertyGroup>

  <!-- 刻意不使用 NuGet：本机沙箱内 HTTPS 直连 nuget.org 不可用（Schannel 受限令牌），
       而游戏已装 BepInEx 5.4.23.5，直接引用其 core 程序集即可。 -->
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCore)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCore)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameManaged)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(GameManaged)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- CanvasGroup（房主闸门用）在 UnityEngine.UIModule 里，UnityEngine.UI.dll 不含它：
         缺这个引用会报 CS1069「CanvasGroup 已转发到 UnityEngine.UIModule」。 -->
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(GameManaged)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Google.Protobuf">
      <HintPath>$(GameManaged)\Google.Protobuf.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Physics2D（视线遮挡判定用，Features/Skill/BearMapMarkFeature）在 UnityEngine.Physics2DModule 里：
         缺这个引用会报 CS0103「当前上下文中不存在名称 Physics2D」，与上面 CanvasGroup 是同一类问题。
         房主进程内有物理世界 —— 游戏服务端代码自己就在用 Physics2D.Raycast（ACS:31428 / :44571）。 -->
    <Reference Include="UnityEngine.Physics2DModule">
      <HintPath>$(GameManaged)\UnityEngine.Physics2DModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
